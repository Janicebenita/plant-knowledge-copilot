# Obtain from https://console.groq.com/keys
GROQ_API_KEY=
# Required: choose an active generative Llama model returned by your Groq account's Models API.
# Do not copy a stale model ID from old documentation.
GROQ_MODEL=

# Optional durable conversation history. If absent, the UI labels history session-only.
MONGODB_URI=
MONGODB_DATABASE=plant_knowledge_copilot

CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=plant_knowledge_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RELEVANCE_THRESHOLD=0.50
TOP_K=5
